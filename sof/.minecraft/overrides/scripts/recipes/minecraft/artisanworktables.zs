import mods.artisanworktables.builder.RecipeBuilder;

RecipeBuilder.get("basic")
  .setShaped([
    [<ore:ingotIron>],
    [<ore:ingotIron>],
    [<ore:stickWood>]])
  .addTool(<ore:toolHammer>, 5)
  .addOutput(<minecraft:iron_sword>)
  .setExtraOutputOne(<pyrotech:material:19>, 0.2)
  .setExperienceRequired(20)
  .create();
 

